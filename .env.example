# Шаблон секретов. Скопируй в .env и заполни. .env в git не попадает.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Единственный администратор бота (числовой user id)
TELEGRAM_ADMIN_ID=

# --- Twitch Helix API ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Cloudflare R2 (S3-совместимый API) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Публичный базовый URL бакета (для ссылок в уведомлениях); опционально
R2_PUBLIC_BASE_URL=

# --- Прочее ---
# Уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Часовой пояс для ежедневной сводки и путей YYYY/MM/DD
TZ=Europe/Moscow
